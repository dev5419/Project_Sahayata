# Project Sahayata - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000

# ===== DATABASE CONFIGURATION =====
# MongoDB Connection String
# Format: mongodb://username:password@host:port/database
# For local development: mongodb://localhost:27017/sahayata_dev
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/sahayata_dev
MONGO_URI=mongodb://localhost:27017/sahayata_dev

# Test database (for running tests)
MONGO_URI_TEST=mongodb://localhost:27017/sahayata_test

# ===== JWT CONFIGURATION =====
# Generate a strong secret key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_EXPIRES_IN=24h

# ===== EMAIL CONFIGURATION =====
# For sending password reset emails and notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@sahayata.edu

# ===== SECURITY CONFIGURATION =====
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ===== ADMIN CONFIGURATION =====
# Default admin credentials (change these in production)
ADMIN_EMAIL=admin@sahayata.edu
ADMIN_PASSWORD=admin123456

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ===== FILE UPLOAD CONFIGURATION =====
# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE=10485760  # 10MB

# Upload directory
UPLOAD_DIR=uploads

# ===== AI CHAT CONFIGURATION =====
# Emergency keywords for crisis detection
EMERGENCY_KEYWORDS=suicide,self-harm,kill myself,end my life,die,death,hopeless,worthless

# ===== ANALYTICS CONFIGURATION =====
# Data retention period (in days)
DATA_RETENTION_DAYS=365

# Anonymization settings
ANONYMIZE_USER_DATA=true
ANONYMIZE_CHAT_LOGS=true

# ===== DEVELOPMENT CONFIGURATION =====
# Enable detailed error messages in development
DEBUG=true

# Seed data for development
SEED_DATA=true

# ===== PRODUCTION CONFIGURATION =====
# Set to true in production
PRODUCTION=false

# SSL/TLS configuration for production
SSL_KEY_PATH=/path/to/ssl/key.pem
SSL_CERT_PATH=/path/to/ssl/cert.pem

# ===== MONITORING CONFIGURATION =====
# Application monitoring
ENABLE_MONITORING=false
MONITORING_URL=

# ===== BACKUP CONFIGURATION =====
# Database backup settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ===== CACHE CONFIGURATION =====
# Redis configuration (optional, for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== THIRD-PARTY INTEGRATIONS =====
# Google Analytics (optional)
GA_TRACKING_ID=

# Sentry for error tracking (optional)
SENTRY_DSN=

# ===== FEATURE FLAGS =====
# Enable/disable features
ENABLE_FORUM=true
ENABLE_CHAT=true
ENABLE_BOOKING=true
ENABLE_RESOURCES=true
ENABLE_ANALYTICS=true

# ===== NOTIFICATION CONFIGURATION =====
# Push notifications (if implemented)
PUSH_NOTIFICATIONS_ENABLED=false
FCM_SERVER_KEY=

# SMS notifications (if implemented)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
